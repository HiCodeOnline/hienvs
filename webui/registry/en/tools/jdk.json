{
  "schemaVersion": 1,
  "id": "jdk",
  "name": "JDK",
  "description": "Java Development Kit, managed uniformly by vendor (Temurin / Corretto / Zulu / Oracle OpenJDK), with multiple coexisting versions and one-click switching",
  "category": "language",
  "homepage": "https://openjdk.org",
  "env": {
    "vars": [
      {
        "name": "JAVA_HOME",
        "value": "{{currentDir}}",
        "expand": true
      }
    ],
    "pathDirs": [
      "bin"
    ]
  },
  "distributions": {
    "temurin": {
      "name": "Eclipse Temurin",
      "description": "OpenJDK distribution from the Eclipse Adoptium working group",
      "homepage": "https://adoptium.net",
      "defaultVersion": "21.0.5+11",
      "platforms": {
        "windows-x64": {
          "archive": "zip",
          "stripComponents": 1,
          "assets": {
            "21.0.5+11": {
              "url": "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.5%2B11/OpenJDK21U-jdk_x64_windows_hotspot_21.0.5_11.zip",
              "mirrors": [
                {
                  "name": "清华 TUNA",
                  "url": "https://mirrors.tuna.tsinghua.edu.cn/Adoptium/21/jdk/x64/windows/OpenJDK21U-jdk_x64_windows_hotspot_21.0.5_11.zip",
                  "size": 205427401
                }
              ]
            },
            "11.0.25+9": {
              "url": "https://github.com/adoptium/temurin11-binaries/releases/download/jdk-11.0.25%2B9/OpenJDK11U-jdk_x64_windows_hotspot_11.0.25_9.zip",
              "mirrors": [
                {
                  "name": "清华 TUNA",
                  "url": "https://mirrors.tuna.tsinghua.edu.cn/Adoptium/11/jdk/x64/windows/OpenJDK11U-jdk_x64_windows_hotspot_11.0.25_9.zip",
                  "size": 199993997
                }
              ]
            }
          },
          "workflowOverrides": {
            "install": [
              {
                "id": "verify",
                "insertAfter": "extract",
                "type": "verify",
                "run": "\"{{versionDir}}{{sep}}bin{{sep}}java{{ext}}\"",
                "args": [
                  "-version"
                ],
                "shell": true,
                "timeoutSec": 60
              }
            ]
          }
        },
        "darwin-arm64": {
          "archive": "tar.gz",
          "stripComponents": 1,
          "assets": {
            "21.0.5+11": {
              "url": "https://github.com/adoptium/temurin21-binaries/releases/download/jdk-21.0.5%2B11/OpenJDK21U-jdk_aarch64_mac_hotspot_21.0.5_11.tar.gz",
              "mirrors": [
                {
                  "name": "清华 TUNA",
                  "url": "https://mirrors.tuna.tsinghua.edu.cn/Adoptium/21/jdk/aarch64/mac/OpenJDK21U-jdk_aarch64_mac_hotspot_21.0.5_11.tar.gz",
                  "size": 199597948
                }
              ]
            }
          },
          "workflowOverrides": {
            "install": [
              {
                "id": "extract",
                "type": "extract",
                "to": "{{tmpDir}}/jdk"
              },
              {
                "id": "flatten",
                "insertAfter": "extract",
                "type": "move",
                "from": "{{tmpDir}}/jdk/Contents/Home",
                "to": "{{versionDir}}"
              },
              {
                "id": "cleanup-tmp",
                "insertAfter": "flatten",
                "type": "cleanup",
                "paths": [
                  "{{tmpDir}}"
                ]
              },
              {
                "id": "verify",
                "insertAfter": "cleanup-tmp",
                "type": "verify",
                "run": "\"{{versionDir}}/bin/java\"",
                "args": [
                  "-version"
